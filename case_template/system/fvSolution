FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Only p is solved. PCG + DIC is the standard choice for symmetric
// positive-definite Laplacian matrices.

solvers
{
    p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0.01;
        minIter         1;
        maxIter         200;
    }
}

// No PIMPLE/SIMPLE block needed — single-equation solver.

// ************************************************************************* //
